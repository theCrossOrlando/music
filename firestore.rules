rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is anyone with a document in /admins keyed by their auth uid.
    // Membership is granted from the Firebase console only (see /admins below),
    // so adding a volunteer never requires a rules deploy.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Published songs are world-readable so an external display surface can
    // fetch them with where('enabled', '==', true). Admins read the full
    // library, drafts included. Only admins write.
    match /lyrics/{doc} {
      allow read: if resource.data.enabled == true || isAdmin();
      allow write: if isAdmin();
    }

    match /scripture/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // A signed-in user may check whether they themselves are an admin, and
    // nothing else. Writes are refused outright: an admin must not be able to
    // promote anyone from inside the app. Grant access by creating
    // admins/<uid> in the Firebase console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Deny access to anything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
